# jacred-go configuration example
# Copy to init.yaml and fill in credentials for trackers you want to use.
# Trackers without credentials can still be parsed for publicly available data.
#
# Comment style: inline comments are supported — a `#` preceded by whitespace
# starts a comment. A `#` inside a token is kept (`u: user#1`), and to keep one
# after a space put the value in double quotes (`p: "pa # word"`).
# Comments are written on their own line throughout this file for readability.
#
# Note: parsing is NOT scheduled by jacred itself. Use the `crontab` file in the
# repo root (system cron -> curl to /cron/<tracker>/...) to drive parse runs.

# ── Server ────────────────────────────────────────────────────────────────────

# "any" listens on all interfaces (0.0.0.0)
listenip: "127.0.0.1"
listenport: 9117

# API key for /api/v1.0/* and /api/v2.0/* endpoints (Jackett/Sonarr/Radarr).
# Leave empty to disable authentication.
apikey: ""

# Key for /dev/* and /cron/* endpoints when accessed from a LAN IP.
# If empty, these endpoints are accessible from any local/private IP without a key.
devkey: ""

# ── Database ──────────────────────────────────────────────────────────────────

# Directory nesting depth for bucket files under Data/fdb/
# 2 (default) creates Data/fdb/ab/cdef...  — recommended for large databases
# 1 creates Data/fdb/a/abcd...
fdbPathLevels: 2

# Merge duplicate entries for the same title from different trackers
mergeduplicates: true
mergenumduplicates: true

# Max number of bucket files read concurrently during a search
maxreadfile: 200

# ── Logging ───────────────────────────────────────────────────────────────────

# General application log to stdout
log: true
# Verbose per-request debug log for parsers
logParsers: false
# Log every FileDB read/write operation
logFdb: false

# Per-tracker parse logs are written to Data/log/<tracker>.log
# Delete log files older than N days (0 = keep forever)
logFdbRetentionDays: 7
# Max total size of all log files in MB (0 = unlimited)
logFdbMaxSizeMb: 100
# Max number of log files per tracker (0 = unlimited)
logFdbMaxFiles: 0

# ── API access ────────────────────────────────────────────────────────────────

# Enable /stats/* endpoints without API key
openstats: true
# Enable /sync/fdb/torrents (V2 protocol) without API key
opensync: true
# Enable /sync/torrents (V1 legacy protocol) without API key
opensync_v1: false
# Serve index.html and stats.html
web: true

# ── Stats ─────────────────────────────────────────────────────────────────────

# Rebuild Data/temp/stats.json every N seconds
timeStatsUpdate: 90

# ── Memory ────────────────────────────────────────────────────────────────────
# Controls Go runtime memory usage. Useful on VPS with limited RAM.
#
# memlimit: hard cap on the Go heap, in MB.
#   When the heap approaches this limit the GC runs very aggressively to stay
#   under it — this prevents OOM-kill at the cost of more CPU for GC.
#   Leave at 0 (disabled) if you have plenty of RAM.
#   Recommended for 2 GB VPS: 1500  (leaves ~500 MB for the OS)
#   Recommended for 1 GB VPS:  700
#
# gcpercent: how often the GC runs (Go's GOGC knob).
#   100 = GC when heap doubles since last collection (Go default).
#    50 = GC when heap grows 50% — twice as frequent, lower peak usage.
#    20 = very aggressive; suitable for very tight memory budgets.
#   -1  = disable GC entirely (not recommended).

memlimit: 0
gcpercent: 50

# ── In-memory bucket cache (Evercache) ────────────────────────────────────────
# Keeps recently opened buckets in memory to reduce disk reads on searches.
# The cache is capped at maxOpenWriteTask entries; when full the oldest
# dropCacheTake entries are evicted. Stale entries (older than validHour) are
# swept periodically by the background evercache cron.
#
#   validHour        — cache TTL in hours; entries older than this are evicted
#   maxOpenWriteTask — max buckets held in memory (reduce to 200-300 on 1 GB VPS)
#   dropCacheTake    — how many buckets to evict when the cap is hit

evercache:
  enable: true
  validHour: 1
  maxOpenWriteTask: 500
  dropCacheTake: 100

# ── CloudFlare bypass (flaresolverr-go) ──────────────────────────────────────
# Built-in CF challenge solver — no external Docker service needed.
# An embedded browser solves CF challenges; cookies are cached per domain in
# Data/cookie/<domain>.json and reused via standard HTTP where possible.
#
# Auto-detect: any tracker that returns a CF challenge during a standard
# request is automatically promoted to flaresolverr routing for future calls.
# The registry persists in Data/temp/cf_auto.json (30-day TTL, refreshed on
# each successful solve, ages out if the site stops challenging).
#
# So `fetchmode: "flaresolverr"` below is only a hint that skips the very first
# detection roundtrip — it is NOT the authority on how a tracker is routed.
# To see what is actually going through the browser: GET /admin/cf-domains.
# Currently hinted: megapeer, nnmclub, bitru, toloka, mazepa, selezen,
# anistar, anifilm.
#
# Requires Xvfb on headless servers: apt install xvfb
#
#   headless        — true = headless, false = visible (needs Xvfb on servers)
#   browser_backend — geckodriver (Camoufox, recommended for CF)
#                     or chromedriver (Chrome for Testing)
#   browser_path    — browser binary. Empty + geckodriver = auto-download
#                     Camoufox (~680 MB, one-time) to ~/.cache.
#                     Empty + chromedriver = use system Chrome.
#   driver_path     — custom geckodriver/chromedriver path.
#                     Empty = auto-download a matching driver.
#   chrome_version  — pin Chrome for Testing to a major (e.g. "146").
#                     Only used with browser_backend: chromedriver.

flaresolverr_go:
  headless: true
  browser_backend: geckodriver
  browser_path: ""
  driver_path: ""
  chrome_version: ""

# ── Multi-instance sync ───────────────────────────────────────────────────────
# Pull torrent data from another jacred instance running elsewhere.

# URL of the remote instance, e.g. "http://192.168.1.10:9117"
syncapi: ""
# Sync interval in seconds
timeSync: 60
# Spider (metadata-only) sync interval in seconds
timeSyncSpidr: 60
# Include sport torrents in sync
syncsport: true
# Enable spider mode (only url/sid/pir, lighter payload)
syncspidr: true

# Sync only these trackers from the remote (empty list = sync all)
synctrackers: []
#  - "Rutor"
#  - "Kinozal"
#  - "NNMClub"

# Never sync these trackers even if listed on the remote
disable_trackers: []
#  - "Mazepa"

# ── Media tracks (ffprobe enrichment) ─────────────────────────────────────────
# When enabled, jacred downloads a static ffprobe into Data/ and inspects
# torrent contents to record audio/subtitle track info on each record.
# Disabled by default — it costs bandwidth and CPU.
#
#   tracksmod    — 0 = default mode
#   tracksdelay  — ms between analysis attempts
#   tracksatempt — retries per torrent before giving up
#   trackslog    — verbose per-torrent analysis log

tracks: false
tracksmod: 0
tracksdelay: 20000
tracksatempt: 5
trackslog: false

# Minutes between passes for the primary (task0) and secondary (task1) tasks
tracksinterval:
  task0: 180
  task1: 60

# Deprecated, kept for init.yaml back-compat — unused since the native ffprobe
# analyzer replaced the TorrServer round-trip:
# trackscategory: "jacred"
# tsuri:
#   - "http://127.0.0.1:8090"

# ── Tracker sections ──────────────────────────────────────────────────────────
# Each section is optional — defaults are used if omitted.
#
# Common keys for every tracker:
#   host               — base URL; change if the tracker moves domain
#   parseDelay         — ms between requests within a single parse call.
#                        For trackers with many categories (Rutor=11,
#                        Kinozal=25, Rutracker=64+) this prevents rate-limit
#                        bans. Set to 0 to disable.
#   reqMinute          — soft limit on requests per minute (0 = no limit)
#   fetchmode          — "flaresolverr" to skip CF auto-detection (see above)
#   insecureSkipVerify — accept invalid/expired TLS certificates
#   useproxy           — route through a matching globalproxy entry
#   log                — per-tracker verbose log
#   cookie             — static session cookie (alternative to login: u/p)
#   login: {u, p}      — credentials; the parser logs in and persists the
#                        session to Data/cookie/<domain>.json, re-logging in
#                        automatically when the cookie expires

# ── Rutor ─────────────────────────────────────────────────────────────────────
# Auth: not required
# Parses 11 categories per page call; parseDelay applies between categories.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Rutor:
  host: "https://rutor.is"
  parseDelay: 7000
  reqMinute: 8

# ── Megapeer ──────────────────────────────────────────────────────────────────
# Auth: not required  |  CF-protected
# Supports: parse?maxpage=N

Megapeer:
  host: "https://megapeer.vip"
  fetchmode: "flaresolverr"
  parseDelay: 3000
  reqMinute: 10

# ── TorrentBy ─────────────────────────────────────────────────────────────────
# Auth: login supported (session persisted, auto-renewed on expiry)
# Uses a certificate from an unknown CA — keep insecureSkipVerify: true.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

TorrentBy:
  host: "https://torrent.by"
  insecureSkipVerify: true
  parseDelay: 5000
  reqMinute: 8
  login:
    u: ""
    p: ""

# ── Kinozal ───────────────────────────────────────────────────────────────────
# Auth: LOGIN REQUIRED for magnet links
# Without credentials torrents are fetched but magnets won't be resolved.
# A static `cookie:` may be used instead of login: u/p.
# Parses 25 categories x year range; parseDelay is critical to avoid bans.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Kinozal:
  host: "https://kinozal.tv"
  parseDelay: 7000
  reqMinute: 6
  login:
    u: ""
    p: ""

# ── NNMClub ───────────────────────────────────────────────────────────────────
# Auth: REQUIRED for magnet links  |  CF-protected
# Either set login: u/p (preferred — the session is renewed automatically),
# or paste a static cookie ("bb_session=...; bb_data=...").
# Without either, only metadata is available.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

NNMClub:
  host: "https://nnmclub.to"
  fetchmode: "flaresolverr"
  cookie: ""
  parseDelay: 5000
  reqMinute: 8
  login:
    u: ""
    p: ""

# ── Bitru ─────────────────────────────────────────────────────────────────────
# Auth: not required  |  CF-protected
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N
#
# The bitruapi parser (/cron/bitruapi/parse?limit=N and
# /cron/bitruapi/parsefromdate?lastnewtor=YYYY-MM-DD) is a separate public-API
# parser for the same site. It has NO config section of its own — it reads the
# Bitru settings below. A "Bitruapi:" section in init.yaml is ignored.

Bitru:
  host: "https://bitru.org"
  fetchmode: "flaresolverr"
  parseDelay: 3000
  reqMinute: 10

# ── Toloka ────────────────────────────────────────────────────────────────────
# Auth: login recommended (required for full access)  |  CF-protected
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Toloka:
  host: "https://toloka.to"
  fetchmode: "flaresolverr"
  parseDelay: 5000
  reqMinute: 6
  login:
    u: ""
    p: ""

# ── Mazepa ────────────────────────────────────────────────────────────────────
# Auth: login optional  |  CF-protected
# Parses 47+ categories — a high parseDelay is recommended.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Mazepa:
  host: "https://mazepa.to"
  parseDelay: 10000
  fetchmode: "flaresolverr"
  reqMinute: 6
  login:
    u: ""
    p: ""

# ── Rutracker ─────────────────────────────────────────────────────────────────
# Auth: LOGIN REQUIRED — without login the site returns nothing useful.
# Parses 64+ categories x year range. A full parse is very long — use
# parselatest daily. Strict rate limits: do not lower parseDelay.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Rutracker:
  host: "https://rutracker.org"
  parseDelay: 8000
  reqMinute: 6
  login:
    u: ""
    p: ""

# ── Selezen ───────────────────────────────────────────────────────────────────
# Auth: login optional  |  CF-protected
# The host below is the built-in default; the site has also been reachable as
# https://selezen.top — set whichever currently resolves.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Selezen:
  host: "https://use.selezen.club"
  fetchmode: "flaresolverr"
  parseDelay: 3000
  reqMinute: 10
  login:
    u: ""
    p: ""

# ── Lostfilm ──────────────────────────────────────────────────────────────────
# Auth: cookie optional (required for HD quality links); no login: u/p support.
# Cookie format: "lf_session=..."
# Supports: parse, parsepages?pageTo=N, parseseasonpacks, verifypage, stats

Lostfilm:
  host: "https://www.lostfilm.tv"
  cookie: ""
  parseDelay: 3000
  reqMinute: 10

# ── Animelayer ────────────────────────────────────────────────────────────────
# Auth: login optional
# Supports: parse?maxpage=N

Animelayer:
  host: "https://animelayer.ru"
  parseDelay: 3000
  reqMinute: 10
  login:
    u: ""
    p: ""

# ── Anidub ────────────────────────────────────────────────────────────────────
# Auth: not required
# Supports: parse?parseFrom=N&parseTo=M

Anidub:
  host: "https://tr.anidub.com"
  parseDelay: 2000
  reqMinute: 15

# ── Aniliberty ────────────────────────────────────────────────────────────────
# Auth: not required (public RSS/API)
# Supports: parse?parseFrom=N&parseTo=M  (response includes lastPage)
# Note: the section key is "Aniliberty", but "Anilibria" is also accepted.

Aniliberty:
  host: "https://aniliberty.top"
  parseDelay: 1000
  reqMinute: 20

# ── Knaben ────────────────────────────────────────────────────────────────────
# Auth: not required (public JSON API)
# API-based search — parseDelay is not used between requests.
# parse?from=0&size=300&pages=1&query=...&hours=24&orderBy=date&categories=...

Knaben:
  host: "https://api.knaben.org"
  parseDelay: 0
  reqMinute: 30

# ── Anistar ───────────────────────────────────────────────────────────────────
# Auth: not required  |  CF-protected
# Supports: parse?limit_page=N  (0 = all pages, default 0)

Anistar:
  host: "https://anistar.org"
  fetchmode: "flaresolverr"
  parseDelay: 3000
  reqMinute: 10

# ── Anifilm ───────────────────────────────────────────────────────────────────
# Auth: login optional (a static cookie is also accepted)  |  CF-protected
# Supports: parse?fullparse=false (incremental) or fullparse=true (all pages)

Anifilm:
  host: "https://anifilm.pro"
  fetchmode: "flaresolverr"
  parseDelay: 3000
  reqMinute: 10
  login:
    u: ""
    p: ""

# ── Leproduction ──────────────────────────────────────────────────────────────
# Auth: not required
# Supports: parse?limit_page=N  (0 = all pages, default 0)

Leproduction:
  host: "https://www.le-production.tv"
  parseDelay: 3000
  reqMinute: 10

# ── Korsars ───────────────────────────────────────────────────────────────────
# Auth: LOGIN REQUIRED — without credentials the site shows no torrent metadata.
# phpBB-mod tracker (films/series/cartoons), magnets inline in listings.
# 24 categories: 6 films + 12 series + 6 cartoons (forum IDs hardcoded).
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Korsars:
  host: "https://korsars.pro"
  parseDelay: 5000
  reqMinute: 8
  login:
    u: ""
    p: ""

# ── Ultradox ──────────────────────────────────────────────────────────────────
# Auth: not required
# Listing -> detail magnet pull. Listing rows carry placeholder magnets (empty
# btih), so the parser follows each detail URL; a detail page exposes 1-3
# quality variants and one record is stored per variant (sid=1, pir=1).
# 6 sections: serial-hd, hd, rufilm, camrip, webrips, anime.
#
# The host moved from ultradox.top (now dead) to ultradox.onl, which 307s to a
# numbered mirror such as 021.ultadox.space — follow the redirect, do not
# hardcode the mirror. The origin answers 503 unless the Referer is a search
# engine; the parser sends the required browser headers itself, so nothing is
# needed here. TLS certificates are valid again, so insecureSkipVerify is off.
# Supports: parse?page=N, updatetasksparse, parsealltask, parselatest?pages=N

Ultradox:
  host: "https://ultradox.onl"
  parseDelay: 5000
  reqMinute: 8

# ── Viruseproject ─────────────────────────────────────────────────────────────
# Auth: not required
# Replaced the removed Baibako parser (same niche: series with translations).
# Supports: parse?limit_page=N  (1 = first page only, 0 = all pages)

Viruseproject:
  host: "https://viruseproject.tv"
  parseDelay: 7000
  reqMinute: 8

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Route specific tracker requests through a proxy.
# Set useproxy: true on the tracker section to activate.
# "pattern" is a regex matched against the tracker host URL.

# globalproxy:
#   - pattern: \.onion
#     list:
#       - "socks5://127.0.0.1:9050"
#     useAuth: false
#     BypassOnLocal: true
#     username: ""
#     password: ""
